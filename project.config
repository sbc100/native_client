[access]
	inheritFrom = native_client
[submit]
	action = cherry pick

[label "Commit-Queue"]
	abbreviation = CQ
	value =  0 Not ready
	value = +1 Dry run
	value = +2 Commit
	defaultValue = 0
	function = NoBlock

[access "refs/heads/*"]
	label-Code-Review = -1..+1 group nacl-committers
	label-Code-Review = -1..+1 group nacl-pnacl-committers
	label-Code-Review = -1..+1 group nacl-contributors
	label-Code-Review = -1..+1 group nacl-toolchain-committers
	label-Commit-Queue = +0..+1 group Registered Users
	label-Commit-Queue = +0..+2 group nacl-committers
	label-Commit-Queue = +0..+2 group nacl-pnacl-committers
	label-Commit-Queue = +0..+2 group nacl-contributors
	label-Commit-Queue = +0..+2 group nacl-toolchain-committers
	labelAs-Commit-Queue = +0..+2 group chrome-commit-bot
	submit = group chrome-commit-bot
	push = group chrome-commit-bot
	forgeAuthor = group chrome-commit-bot
